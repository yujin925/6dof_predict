DATA_DIR = "data_6dof_scaled"
file_paths = sorted(glob.glob(os.path.join(DATA_DIR, "*.csv")))
print("발견된 파일 수:", len(file_paths))

if len(file_paths) == 0:
    raise RuntimeError("data_6dof_scaled 폴더에 csv가 없습니다. 경로를 확인해주세요.")

dof_cols = ["surge", "sway", "heave", "roll", "pitch", "yaw"]

all_list = []
file_lengths = [] # 각 파일의 길이를 저장할 리스트

for p in file_paths:
    df = pd.read_csv(p)
    arr = df[dof_cols].values.astype(np.float32)
    all_list.append(arr)
