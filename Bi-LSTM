class TimeWindowDataset(Dataset):
    def __init__(self, data: np.ndarray, indices: np.ndarray, in_len: int = IN_LEN, out_len: int = OUT_LEN):
        self.data    = torch.from_numpy(data.astype(np.float32))
        self.indices = indices.astype(np.int64)
        self.in_len  = in_len
        self.out_len = out_len

    def __len__(self):
        return len(self.indices)

    def __getitem__(self, idx):
        s = int(self.indices[idx])
        e_in  = s + self.in_len
        e_out = e_in + self.out_len
        x = self.data[s:e_in, :]      # (IN_LEN, 6)
        y = self.data[e_in:e_out, :]  # (OUT_LEN, 6)
        return x, y

BATCH_SIZE = 64 
train_loader = DataLoader(TimeWindowDataset(data_6dof, idx_train), batch_size=BATCH_SIZE, shuffle=True, drop_last=True, num_workers=4, pin_memory=True)
val_loader   = DataLoader(TimeWindowDataset(data_6dof, idx_val), batch_size=BATCH_SIZE, shuffle=False, num_workers=4, pin_memory=True)
test_loader  = DataLoader(TimeWindowDataset(data_6dof, idx_test), batch_size=BATCH_SIZE, shuffle=False, num_workers=4, pin_memory=True)

# -----------------------------
# Single-Shot Many-to-Many RNN
# -----------------------------
class SingleShotRNN(nn.Module):
    def __init__(self, input_dim=6, output_dim=6, in_len=256, out_len=256, 
                 hidden_dim=256, n_layers=4, bidirectional=True, rnn_type="GRU"):
        super().__init__()
        self.in_len = in_len
        self.out_len = out_len
        self.output_dim = output_dim
        
        RNN = nn.LSTM if rnn_type.upper() == "LSTM" else nn.GRU
        self.rnn = RNN(input_dim, hidden_dim, n_layers, batch_first=True, bidirectional=bidirectional)
        
        # 양방향(Bi-directional)이면 은닉 상태 크기가 2배가 됨
        D = 2 if bidirectional else 1
        
        # RNN의 마지막 타임스텝 결과를 받아, 미래 전체(out_len * output_dim)를 한 번에 예측
        self.fc = nn.Linear(hidden_dim * D, out_len * output_dim)

    def forward(self, x):
        # x: (Batch, IN_LEN, 6)
        out, _ = self.rnn(x) # out: (Batch, IN_LEN, hidden_dim * D)
        
        # 과거 데이터를 모두 읽은 후의 마지막 상태(last hidden state)만 추출
        last_hidden = out[:, -1, :] # (Batch, hidden_dim * D)
        
        # 한 번의 계산(Single-Shot)으로 미래 데이터를 모두 예측
        pred = self.fc(last_hidden) # (Batch, OUT_LEN * 6)
        
        # (Batch, OUT_LEN * 6) -> (Batch, OUT_LEN, 6) 형태로 변환하여 반환
        pred = pred.view(-1, self.out_len, self.output_dim)
        return pred


