# ==============================
# 2. 윈도우 개수 계산 (경계선 침범 방지 + STRIDE 적용)
# ==============================
sampling_rate = 10        # Hz
IN_LEN  = 256             # 입력 시퀀스 길이
OUT_LEN = 256             # 출력 시퀀스 길이
STRIDE = 4                # 윈도우 이동 간격

valid_starts = []
current_offset = 0

# 각 파일별로 안전한 윈도우 시작점만 추출
for L in file_lengths:
    max_start = L - IN_LEN - OUT_LEN
    if max_start >= 0:
        # 해당 파일 내에서 STRIDE 간격으로 시작 인덱스 생성
        starts = np.arange(0, max_start + 1, STRIDE) + current_offset
        valid_starts.extend(starts)
    current_offset += L

valid_starts = np.array(valid_starts)
N_window = len(valid_starts)
print("안전하게 추출된 전체 윈도우 개수:", N_window)

# 안전한 인덱스들을 무작위로 섞음
all_indices = np.random.permutation(valid_starts)

train_ratio = 0.7
val_ratio   = 0.15  # 나머지 0.15는 test

n_train = int(N_window * train_ratio)
n_val   = int(N_window * val_ratio)
n_test  = N_window - n_train - n_val

idx_train = all_indices[:n_train]
idx_val   = all_indices[n_train:n_train + n_val]
idx_test  = all_indices[n_train + n_val:]

print(f"Train windows: {len(idx_train)}, Val: {len(idx_val)}, Test: {len(idx_test)}")

