# ==============================
# 5. Seq2Seq 전용 Training & Evaluation Loops
# ==============================
class EarlyStopping:
    def __init__(self, patience=10, delta=0, path='models/checkpoint.pt'):
        self.patience = patience
        self.delta = delta
        self.path = path
        self.counter = 0
        self.best_score = None
        self.early_stop = False

    def __call__(self, val_loss, model):
        score = -val_loss
        if self.best_score is None or score > self.best_score + self.delta:
            self.best_score = score
            torch.save(model.state_dict(), self.path)
            self.counter = 0
        else:
            self.counter += 1
            if self.counter >= self.patience:
                self.early_stop = True

def train(model, loader, optimizer, criterion):
    model.train()
    epoch_loss = 0.0
    for src, trg in tqdm(loader, desc="Train(step)", leave=False):
        src, trg = src.to(device), trg.to(device)
        
        optimizer.zero_grad()
        output = model(src)  # TFR, Target 입력 모두 제거됨
        loss = criterion(output, trg)
        loss.backward()
        optimizer.step()
        
        epoch_loss += loss.item()
    return epoch_loss / max(1, len(loader))

@torch.no_grad()
def evaluate(model, loader, criterion):
    model.eval()
    epoch_loss = 0.0
    for src, trg in tqdm(loader, desc="Valid(step)", leave=False):
        src, trg = src.to(device), trg.to(device)
        
        output = model(src)  # TFR, Target 입력 모두 제거됨
        loss = criterion(output, trg)
        
        epoch_loss += loss.item()
    return epoch_loss / max(1, len(loader))

def build_model(model_type, n_layers, hidden_size):
    model_type = model_type.upper()
    if model_type not in ["LSTM", "BI-LSTM", "GRU", "BI-GRU"]:
        raise ValueError(f"Unknown model_type: {model_type}")

    is_bi = ("BI" in model_type)
    rnn_core = "GRU" if "GRU" in model_type else "LSTM"

    model = SingleShotRNN(
        input_dim=6,          # 수정됨
        output_dim=6,         # 수정됨
        in_len=IN_LEN, 
        out_len=OUT_LEN,
        hidden_dim=hidden_size, 
        n_layers=n_layers, 
        bidirectional=is_bi, 
        rnn_type=rnn_core
    ).to(device)


    return model


# ===========================
# 🔧 Optuna: 하이퍼파라미터 튜닝
# ===========================
USE_GRAD_TRACKER_FOR_BEST = True
MAX_EPOCHS = 300
PATIENCE   = 15

LR = 1e-3

def objective(trial: optuna.Trial):
    model_type  = trial.suggest_categorical("model_type", ["Bi-GRU", "Bi-LSTM"])
    n_layers    = trial.suggest_int("n_layers", low=1, high=5)
    hidden_size = trial.suggest_categorical("hidden_size", [64, 128, 256])
    batch_size  = trial.suggest_categorical("batch_size", [64, 128])

    lr  = LR

    set_seed(100 + trial.number)

    # DataLoader 
    train_loader_opt = DataLoader(TimeWindowDataset(data_6dof, idx_train), batch_size=batch_size, shuffle=True, num_workers=4, pin_memory=True, drop_last=True)
    val_loader_opt   = DataLoader(TimeWindowDataset(data_6dof, idx_val), batch_size=batch_size, shuffle=False, num_workers=4, pin_memory=True)

    model = build_model(model_type, n_layers, hidden_size)
    
    # 1. 옵티마이저 선언
    opt   = optim.Adam(model.parameters(), lr=lr)
    
    # 2. 🔥 스케줄러 선언 추가
    scheduler = ReduceLROnPlateau(
        opt,
        mode='min',
        factor=0.5,
        patience=5,
        min_lr=1e-6
    )
    
    crit  = nn.MSELoss()

    ckpt_path = f"models/{model_type}_L{n_layers}_H{hidden_size}_B{batch_size}.pt"
    trial.set_user_attr("ckpt_path", ckpt_path)
    es = EarlyStopping(patience=PATIENCE, path=ckpt_path)

    tr_hist, va_hist = [], []
    best_va = float("inf")

    for ep in range(1, MAX_EPOCHS + 1):
        tr_loss = train(model, train_loader_opt, opt, crit)
        va_loss = evaluate(model, val_loader_opt, crit)
        
        # 3. 🔥 검증 손실(va_loss)을 기준으로 스케줄러 업데이트
        scheduler.step(va_loss)
        

        tr_hist.append(tr_loss)
        va_hist.append(va_loss)

        trial.report(va_loss, ep)
        if trial.should_prune():
            raise optuna.exceptions.TrialPruned()
       
        print(f"Epoch {ep:03d}/{MAX_EPOCHS:03d} | Train Loss (MSE): {tr_loss:.4f} | Val Loss (MSE): {va_loss:.4f}")
        es(va_loss, model)
        if va_loss < best_va: 
            best_va = va_loss
            
        if es.early_stop: 
            print(f"Early stopping triggered at epoch {ep}")
            break

    model_name = f"{model_type}_L{n_layers}_H{hidden_size}_B{batch_size}"
    try:
        with open(f"results/{model_name}_history.json","w") as f:
            json.dump({'train': tr_hist, 'val': va_hist}, f)
    except Exception as e:
        print(f"Save history error: {e}")

    return best_va

if __name__ == "__main__":
    study = optuna.create_study(direction="minimize", pruner=MedianPruner(n_warmup_steps=10))000
    # =========================================================
    # 🔥 추가된 부분: 기존 CSV를 읽고 상위 파라미터를 큐에 삽입
    # =========================================================
    csv_path = "results/optuna_trials.csv"
    if os.path.exists(csv_path):
        print(f"📊 기존 학습 기록({csv_path})을 발견했습니다. 이전 최적의 모델부터 탐색을 시작합니다.")
        try:
            df = pd.read_csv(csv_path)
            
            # 학습이 정상적으로 완료된(COMPLETE) 기록만 필터링
            if 'state' in df.columns:
                df = df[df['state'] == 'COMPLETE']
            
            # MSE(value) 값이 가장 낮은(좋은) 순서대로 오름차순 정렬
            if 'value' in df.columns:
                df = df.sort_values(by='value', ascending=True)

                # 상위 N개의 파라미터를 추출하여 큐에 추가 (예: 상위 3개)
                top_k = 1
                enqueued_count = 0
                
                for _, row in df.head(top_k).iterrows():
                    # Optuna가 저장한 CSV는 컬럼명에 'params_' 접두사가 붙습니다.
                    params = {
                        "model_type": str(row['params_model_type']),
                        "n_layers": int(row['params_n_layers']),
                        "hidden_size": int(row['params_hidden_size']),
                        "batch_size": int(row['params_batch_size'])
                    }
                    
                    # 큐에 파라미터 삽입 (이 조합부터 먼저 학습을 수행함)
                    study.enqueue_trial(params)
                    enqueued_count += 1
                
                print(f"✅ 상위 {enqueued_count}개의 파라미터 조합을 탐색 큐(Queue)에 추가했습니다!")
            
        except Exception as e:
            print(f"⚠️ CSV 기록을 불러오는 중 오류가 발생했습니다: {e}")

    study.optimize(objective, n_trials=5, show_progress_bar=True)

    # === Optuna 결과 테이블 CSV 저장 ===
    df = study.trials_dataframe(
        attrs=("number","value","params","state","user_attrs","datetime_start","datetime_complete","duration")
    )
    df.to_csv("results/0optuna_trials.csv", index=False)
    print("Trials CSV saved → results/optuna_trials.csv")

    # === 베스트 트라이얼 메타 JSON 저장 ===
    bp = study.best_trial.params
    best_ckpt = study.best_trial.user_attrs.get(
        "ckpt_path",
        f"models/OPTUNA_{bp['model_type']}_L{bp['n_layers']}_H{bp['hidden_size']}_B{bp['batch_size']}.pt"
    )
    best_meta = {"best_value": float(study.best_value), "best_params": bp, "best_ckpt": best_ckpt}
    with open("results/0optuna_best.json", "w", encoding="utf-8") as f:
        json.dump(best_meta, f, ensure_ascii=False, indent=2)
        
    print("\n===== Optuna 결과 =====")
    print(f"Best value (val MSE): {study.best_value:.6f}")
    print(f"Best checkpoint: {best_ckpt}")
    print("Best params:")
    for k, v in bp.items():
        print(f"  - {k}: {v}")

